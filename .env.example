# Copie para .env (não versionado) e preencha. Em produção, defina essas
# variáveis direto na configuração do servidor (ex.: aba Web do PythonAnywhere).

SECRET_KEY=troque-por-uma-chave-aleatoria-longa

# Deixe em 1 em produção (exige HTTPS). Em desenvolvimento local sem HTTPS,
# use 0 para conseguir logar em http://localhost.
SESSION_COOKIE_SECURE=1

# Usuários criados por "python criar_usuario.py" (sem argumento nenhum).
# A senha só fica em texto puro aqui, nesse arquivo fora do git; no banco
# ela sempre é salva com hash. Pode apagar essas linhas depois de rodar
# o script uma vez, ou deixar pra rodar de novo quando quiser trocar senha.
USUARIO_1=maria
SENHA_1=troque-por-uma-senha-forte
# USUARIO_2=joao
# SENHA_2=outra-senha-forte
